{
  "name": "forefill",
  "private": false,
  "version": "0.1.2",
  "description": "ForeFill — inline ghost-text autocomplete for React textareas, textboxes, and contenteditable surfaces.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenesuino/ForeFill.git"
  },
  "bugs": {
    "url": "https://github.com/kenesuino/ForeFill/issues"
  },
  "homepage": "https://kenesuino.github.io/ForeFill/",
  "keywords": [
    "react",
    "forefill",
    "ghost-text",
    "textarea",
    "textbox",
    "contenteditable",
    "autocomplete",
    "autosuggest",
    "typeahead",
    "inline-autocomplete"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sideEffects": [
    "*.css",
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('node:fs');for(const dir of ['dist','site-dist'])fs.rmSync(dir,{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:styles": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/lib/styles/forefill.css','dist/styles.css')\"",
    "build:site": "vite build --config vite.config.ts",
    "build": "npm run clean && npm run typecheck && npm run test && npm run build:js && npm run build:types && npm run build:styles",
    "release:check": "npm run build && npm run pack:dry",
    "publish:npm": "npm run release:check && npm publish",
    "pack:dry": "npm pack --dry-run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.21.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
