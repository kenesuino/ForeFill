{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src/lib",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/lib/**/*"],
  "exclude": [
    "src/lib/**/*.test.ts",
    "src/lib/**/*.test.tsx",
    "src/lib/**/*.spec.ts",
    "src/lib/**/*.spec.tsx"
  ]
}
